# Cloudflare Workers AI clef-flash.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional Cline SDK incident responder. Loaded only with respond --sdk.
WARDEN_RESPONDER_PROVIDER=openai-native
WARDEN_RESPONDER_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# WARDEN_RESPONDER_API_KEY=  # Optional override for the selected provider.

# Optional local Ollama (only attempted if Cloudflare is NOT configured) and offline controls.
# WARDEN_OLLAMA_URL=http://127.0.0.1:11434
# WARDEN_ENABLE_OLLAMA=1
# WARDEN_RISK_OFFLINE=0
# Hook defaults: Cloudflare 1000ms; local Ollama 350ms. Override range: 1-5000ms.
# WARDEN_CLEF_TIMEOUT_MS=1000
# Privacy opt-in: send bounded, gated action/intent text to Cloudflare (may contain source code).
# Structural-only remains the default; suspected secrets/canaries stay structural-only.
# WARDEN_CLOUDFLARE_SEND_SAFE_STATE=1
# WARDEN_DEMO_CLEF_TIMEOUT_MS=10000